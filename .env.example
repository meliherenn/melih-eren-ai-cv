# Optional local environment variables.
# Streamlit secrets are preferred for deployed apps.

LLM_PROVIDER=cerebras
LLM_MODEL=gpt-oss-120b
CEREBRAS_API_KEY=replace-with-your-cerebras-key

# The public portfolio is read-only by default. Enable this only on a trusted
# deployment and use a long, unique password.
ENABLE_ADMIN_PANEL=false
ADMIN_PASSWORD=replace-with-a-strong-password

# Abuse-control defaults (the app clamps unsafe values).
MAX_INPUT_CHARS=1200
MAX_LIVE_REQUESTS_PER_SESSION=20
ADMIN_MAX_ATTEMPTS=5
ADMIN_LOCK_SECONDS=90
